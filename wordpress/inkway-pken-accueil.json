                            "widgetType": "html",
                            "settings": {
                                "html": "<div class=\"pken-embed\"><section class=\"hero\" style=\"padding:0\"><div class=\"wrap\">\n  <div>\n    <span class=\"status\" data-open-status data-reveal></span>\n    <h1 data-reveal>Votre coiffeur<br>à <span class=\"script\">Alfortville.</span></h1>\n    <p class=\"lead\" data-reveal>Coupe homme, barbe et coupe enfant, à deux pas du boulevard Carnot. Un accueil convivial, des prix clairs et un café qui vous attend.</p>\n    <div data-reveal style=\"display:flex;gap:12px;flex-wrap:wrap\">\n      <a class=\"btn btn-xl\" href=\"#rdv\">Prendre rendez-vous</a>\n    </div>\n    <div class=\"chips\" data-reveal><span class=\"chip\">Coupe homme <b>[pken prix='Coupe homme']</b></span><span class=\"chip\">Barbe <b>[pken prix='Barbe']</b></span><span class=\"chip\">Eau, café &amp; thé <b>offerts</b></span><span class=\"chip\">10<sup>e</sup> coupe <b>offerte</b></span></div>\n  </div>\n  <div class=\"hv\" data-reveal>\n    <span class=\"ring\"></span><span class=\"ring r2\"></span>\n    <div class=\"photo\"><img src=\"[pken img='hero-coiffeur.webp']\" alt=\"\" width=\"1080\" height=\"720\"></div>\n    <div class=\"logo\"><img src=\"[pken logo]\" alt=\"Logo PKEN Coiffure\"></div>\n    <div class=\"orbit o1\" aria-hidden=\"true\"><div class=\"opos\"><span class=\"tag t1\">Ouvert 7j/7<small>dimanche inclus</small></span></div></div>\n    <div class=\"orbit o2\" aria-hidden=\"true\"><div class=\"opos\"><span class=\"tag t2\">Coupe enfant<small>[pken prix='Coupe enfant']</small></span></div></div>\n  </div>\n</div></section>\n</div>"
                            }
                        }
